NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# Set to true behind a load balancer / reverse proxy so client IPs are correct
TRUST_PROXY=false

# Matches docker-compose.yml at the repo root (Postgres on host port 5433)
DATABASE_URL=postgresql://breastscan:breastscan_dev@localhost:5433/breastscan?schema=public

# Secrets: generate fresh values for every environment with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production keep them in a secrets manager, not in a .env file.
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxx
TOKEN_HASH_SECRET=change-me-at-least-32-characters-long-yyyy
# Must decode to exactly 32 bytes
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# local (development) or s3 (any S3-compatible private bucket, e.g. Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ClamAV daemon. Leave unset to skip malware scanning with a warning.
# "docker compose --profile scan up -d" starts one on port 3310.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Without GEMINI_API_KEY a clearly labelled mock provider is used (never allowed in production).
# Use a PAID-tier key only: free-tier content may be used by Google and read by human reviewers.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Tried once if the main model returns a server error (Google preview models can be unstable)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Only used for the admin spend estimate; copy from the current Gemini price list.
GEMINI_INPUT_USD_PER_MTOK=0
GEMINI_OUTPUT_USD_PER_MTOK=0
UPLOADS_PER_DAY=100

# Without RESEND_API_KEY emails (e.g. password-reset links) are printed to the API log.
# Leave unset to degrade gracefully while the app is starting up.
# RESEND_API_KEY=
MAIL_FROM=BreastScan AI <no-reply@breastscan.local>

# SENTRY_DSN=
ACCOUNT_DELETION_GRACE_DAYS=30

# Test patient created by "npm run db:seed" (development only)
SEED_TEST_EMAIL=test@breastscan.local
SEED_TEST_PASSWORD=Test-Passw0rd!
